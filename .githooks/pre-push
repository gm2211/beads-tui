#!/usr/bin/env bash
# pre-push hook: ensure local version in pyproject.toml is greater than remote main.
#
# Setup (run once per clone):
#   git config core.hooksPath .githooks
#
# This hook prevents pushing if the version in pyproject.toml has not been
# bumped beyond what is on origin/main. It uses Python for version comparison.

set -euo pipefail

LOCAL_PYPROJECT="pyproject.toml"

# Extract local version
if [[ ! -f "$LOCAL_PYPROJECT" ]]; then
    echo "pre-push: No pyproject.toml found locally. Allowing push."
    exit 0
fi

LOCAL_VERSION=$(python3 -c "
import re, sys
with open('$LOCAL_PYPROJECT') as f:
    m = re.search(r'^version\s*=\s*\"([^\"]+)\"', f.read(), re.MULTILINE)
    if m:
        print(m.group(1))
    else:
        print('0.0.0')
")

# Sync __init__.py version with pyproject.toml
INIT_FILE="beads_tui/__init__.py"
if [[ -f "$INIT_FILE" ]]; then
    INIT_VERSION=$(python3 -c "
import re
with open('$INIT_FILE') as f:
    m = re.search(r'^__version__\s*=\s*\"([^\"]+)\"', f.read(), re.MULTILINE)
    print(m.group(1) if m else '')
")
    if [[ -n "$INIT_VERSION" && "$INIT_VERSION" != "$LOCAL_VERSION" ]]; then
        python3 -c "
import re
with open('$INIT_FILE', 'r') as f:
    content = f.read()
content = re.sub(
    r'^(__version__\s*=\s*\")([^\"]+)(\")',
    r'\g<1>$LOCAL_VERSION\3',
    content,
    flags=re.MULTILINE
)
with open('$INIT_FILE', 'w') as f:
    f.write(content)
"
        git add "$INIT_FILE"
        git commit --amend --no-edit --quiet 2>/dev/null || true
        echo "pre-push: Synced $INIT_FILE version to $LOCAL_VERSION"
    fi
fi

# Fetch latest remote main (suppress output)
git fetch origin main --quiet 2>/dev/null || true

# Extract remote version from origin/main
REMOTE_VERSION=$(git show origin/main:pyproject.toml 2>/dev/null | python3 -c "
import re, sys
content = sys.stdin.read()
m = re.search(r'^version\s*=\s*\"([^\"]+)\"', content, re.MULTILINE)
if m:
    print(m.group(1))
else:
    print('0.0.0')
" 2>/dev/null || echo "0.0.0")

# Compare versions using Python's packaging-style comparison
RESULT=$(python3 -c "
import sys

def parse_version(v):
    \"\"\"Parse a version string into a tuple of integers.\"\"\"
    try:
        return tuple(int(x) for x in v.strip().split('.'))
    except (ValueError, AttributeError):
        return (0, 0, 0)

local = parse_version('$LOCAL_VERSION')
remote = parse_version('$REMOTE_VERSION')

if local <= remote:
    print('BLOCKED')
else:
    print('OK')
")

if [[ "$RESULT" == "BLOCKED" ]]; then
    echo ""
    echo "=========================================="
    echo " VERSION NOT BUMPED!"
    echo "=========================================="
    echo ""
    echo " Local version:  $LOCAL_VERSION"
    echo " Remote main:    $REMOTE_VERSION"
    echo ""
    echo " Local version ($LOCAL_VERSION) must be greater than remote main ($REMOTE_VERSION)."
    echo ""
    echo " Run:"
    echo "   python3 -c \"import re; p='pyproject.toml'; t=open(p).read(); v=re.search(r'version\s*=\s*\\\"([^\\\"]+)\\\"',t).group(1); parts=v.split('.'); parts[-1]=str(int(parts[-1])+1); open(p,'w').write(t.replace(v,'.'.join(parts)))\""
    echo ""
    echo " Or manually edit pyproject.toml to bump the version."
    echo ""
    exit 1
fi

echo "pre-push: Version check passed ($LOCAL_VERSION > $REMOTE_VERSION)."
exit 0
